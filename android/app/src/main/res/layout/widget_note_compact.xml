<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_paper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_header_height_compact">
        <ImageView
            android:id="@+id/widget_header_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_header_base"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/widget_header_light"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_header"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/widget_header_padding_compact"
            android:paddingEnd="@dimen/widget_header_padding_compact">
            <ImageView
                android:id="@+id/widget_header_icon"
                android:visibility="gone"
                android:layout_width="@dimen/widget_header_icon_width_compact"
                android:layout_height="@dimen/widget_header_icon_width_compact"
                android:src="@drawable/ic_widget_folder"
                android:contentDescription="@null"
                android:layout_marginEnd="@dimen/widget_header_icon_gap_compact"/>
            <TextView
                android:textSize="@dimen/widget_header_emoji_size_compact"
                android:id="@+id/widget_header_emoji"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginEnd="@dimen/widget_header_icon_gap_compact"/>
            <FrameLayout
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/widget_header_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:tint="@color/widget_header_text"
                    android:tintMode="src_in"/>
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/widget_header_title_emoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <include layout="@layout/widget_perforation_bar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_content"
        android:paddingTop="@dimen/widget_pad_top_compact"
        android:paddingBottom="@dimen/widget_pad_bottom_compact"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/widget_content_padding_compact"
        android:paddingEnd="@dimen/widget_content_padding_compact">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/widget_note_empty_icon"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_widget_quick_note_empty"
            android:contentDescription="@null"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/widget_note_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="matrix"
            android:tint="@color/widget_secondary_label"
            android:tintMode="src_in"/>
        <FrameLayout
            android:layout_gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/widget_note_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="matrix"
                android:tint="@color/widget_label"
                android:tintMode="src_in"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/widget_note_title_emoji"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="matrix"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/widget_note_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_pad_body_gap_compact"
                android:scaleType="matrix"
                android:tint="@color/widget_secondary_label"
                android:tintMode="src_in"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/widget_note_body_emoji"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_pad_body_gap_compact"
                android:scaleType="matrix"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/widget_note_photo"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:layout_weight="1"
            android:contentDescription="@null"/>
        <FrameLayout
            android:id="@+id/widget_note_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/widget_note_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_pad_date_gap_compact"
            android:scaleType="matrix"
            android:tint="@color/widget_secondary_label"
            android:tintMode="src_in"/>
    </LinearLayout>
</LinearLayout>
