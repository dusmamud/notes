                    android:layout_gravity="start"
                    android:id="@+id/widget_row_5_subtitle_emoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/widget_row_5_thumb"
                android:visibility="gone"
                android:layout_width="@dimen/widget_thumb_size_compact"
                android:layout_height="@dimen/widget_thumb_size_compact"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/widget_thumb_gap_compact"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/widget_rows_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="matrix"
            android:tint="@color/widget_secondary_label"
            android:tintMode="src_in"/>
    </LinearLayout>
</LinearLayout>
