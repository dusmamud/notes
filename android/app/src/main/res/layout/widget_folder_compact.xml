<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_paper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_header_height_compact">
        <ImageView
            android:id="@+id/widget_header_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_header_base"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/widget_header_light"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_header"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/widget_header_padding_compact"
            android:paddingEnd="@dimen/widget_header_padding_compact">
            <ImageView
                android:id="@+id/widget_header_icon"
                android:visibility="gone"
                android:layout_width="@dimen/widget_header_icon_width_compact"
                android:layout_height="@dimen/widget_header_icon_width_compact"
                android:src="@drawable/ic_widget_folder"
                android:contentDescription="@null"
                android:layout_marginEnd="@dimen/widget_header_icon_gap_compact"/>
            <TextView
                android:textSize="@dimen/widget_header_emoji_size_compact"
                android:id="@+id/widget_header_emoji"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginEnd="@dimen/widget_header_icon_gap_compact"/>
            <FrameLayout
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/widget_header_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:tint="@color/widget_header_text"
                    android:tintMode="src_in"/>
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/widget_header_title_emoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <include layout="@layout/widget_perforation_bar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_rows"
        android:paddingTop="@dimen/widget_rows_padding_compact"
        android:paddingBottom="@dimen/widget_rows_padding_compact"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/widget_content_padding_compact"
        android:paddingEnd="@dimen/widget_content_padding_compact">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/widget_row_0"
            android:paddingTop="@dimen/widget_row_spacing_compact"
            android:paddingBottom="@dimen/widget_row_spacing_compact"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_row_0_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_label"
                    android:tintMode="src_in"/>
                <ImageView
                    android:id="@+id/widget_row_0_title_emoji"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_0_subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"/>
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_0_subtitle_emoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/widget_row_0_thumb"
                android:visibility="gone"
                android:layout_width="@dimen/widget_thumb_size_compact"
                android:layout_height="@dimen/widget_thumb_size_compact"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/widget_thumb_gap_compact"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/widget_row_1"
            android:paddingTop="@dimen/widget_row_spacing_compact"
            android:paddingBottom="@dimen/widget_row_spacing_compact"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_row_1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_label"
                    android:tintMode="src_in"/>
                <ImageView
                    android:id="@+id/widget_row_1_title_emoji"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_1_subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"/>
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_1_subtitle_emoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/widget_row_1_thumb"
                android:visibility="gone"
                android:layout_width="@dimen/widget_thumb_size_compact"
                android:layout_height="@dimen/widget_thumb_size_compact"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/widget_thumb_gap_compact"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/widget_row_2"
            android:paddingTop="@dimen/widget_row_spacing_compact"
            android:paddingBottom="@dimen/widget_row_spacing_compact"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_row_2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_label"
                    android:tintMode="src_in"/>
                <ImageView
                    android:id="@+id/widget_row_2_title_emoji"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_2_subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"/>
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_2_subtitle_emoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/widget_row_2_thumb"
                android:visibility="gone"
                android:layout_width="@dimen/widget_thumb_size_compact"
                android:layout_height="@dimen/widget_thumb_size_compact"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/widget_thumb_gap_compact"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/widget_row_3"
            android:paddingTop="@dimen/widget_row_spacing_compact"
            android:paddingBottom="@dimen/widget_row_spacing_compact"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_row_3_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_label"
                    android:tintMode="src_in"/>
                <ImageView
                    android:id="@+id/widget_row_3_title_emoji"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_3_subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
