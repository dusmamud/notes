                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_3_subtitle_emoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/widget_row_3_thumb"
                android:visibility="gone"
                android:layout_width="@dimen/widget_thumb_size_compact"
                android:layout_height="@dimen/widget_thumb_size_compact"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/widget_thumb_gap_compact"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/widget_row_4"
            android:paddingTop="@dimen/widget_row_spacing_compact"
            android:paddingBottom="@dimen/widget_row_spacing_compact"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_row_4_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_label"
                    android:tintMode="src_in"/>
                <ImageView
                    android:id="@+id/widget_row_4_title_emoji"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_4_subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"/>
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_4_subtitle_emoji"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/widget_row_4_thumb"
                android:visibility="gone"
                android:layout_width="@dimen/widget_thumb_size_compact"
                android:layout_height="@dimen/widget_thumb_size_compact"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/widget_thumb_gap_compact"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/widget_row_5"
            android:paddingTop="@dimen/widget_row_spacing_compact"
            android:paddingBottom="@dimen/widget_row_spacing_compact"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/widget_row_5_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_label"
                    android:tintMode="src_in"/>
                <ImageView
                    android:id="@+id/widget_row_5_title_emoji"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/widget_row_5_subtitle"
