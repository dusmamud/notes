<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/widget_paper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/widget_header_base"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_header_height"
        android:foreground="@drawable/widget_header"
        android:paddingStart="@dimen/widget_header_padding"
        android:paddingEnd="@dimen/widget_header_padding">
        <ImageView
            android:layout_width="@dimen/widget_header_icon_box"
            android:layout_height="15.25dp"
            android:src="@drawable/ic_widget_folder"
            android:contentDescription="@null"
            android:paddingStart="@dimen/widget_header_icon_margin"
            android:paddingEnd="@dimen/widget_header_icon_margin"/>
    </LinearLayout>
    <include layout="@layout/widget_perforation_bar"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/widget_pad_top"
        android:paddingBottom="@dimen/widget_pad_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/widget_content_padding"
        android:paddingEnd="@dimen/widget_content_padding">
        <ImageView
            android:layout_width="92dp"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/widget_preview_bar"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:alpha="1"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/widget_preview_bar"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:alpha="0.55"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/widget_preview_bar"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:alpha="0.55"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="8dp"
            android:layout_marginTop="0dp"
            android:src="@drawable/widget_preview_bar"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:alpha="0.55"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"/>
    </LinearLayout>
</LinearLayout>
