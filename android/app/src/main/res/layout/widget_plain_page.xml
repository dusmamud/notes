<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_paper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/widget_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="matrix"
            android:tint="@color/widget_page_text"
            android:tintMode="src_in"/>
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/widget_page_title_emoji"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="matrix"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="start"
        android:id="@+id/widget_page_body_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/widget_page_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="matrix"
            android:tint="@color/widget_page_text"
            android:tintMode="src_in"/>
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/widget_page_body_emoji"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="matrix"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/widget_page_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="matrix"
        android:tint="@color/widget_date"
        android:tintMode="src_in"/>
</LinearLayout>
