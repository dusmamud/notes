<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/widget_capture_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_capture_bg"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/widget_capture_padding"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/widget_capture_new"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_capture_key_size"
                android:layout_weight="1"
                android:contentDescription="@string/widget_new_note_label">
                <ImageView
                    android:id="@+id/widget_header_base"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_capture_pill_base"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"/>
                <ImageView
                    android:id="@+id/widget_capture_pill_light"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_capture_pill"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/widget_capture_mark_size"
                        android:layout_height="@dimen/widget_capture_mark_size"
                        android:src="@drawable/ic_widget_compose"
                        android:scaleType="fitCenter"
                        android:tint="@color/widget_header_text"
                        android:importantForAccessibility="no"
                        android:tintMode="src_in"/>
                    <ImageView
                        android:id="@+id/widget_capture_new_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="matrix"
                        android:tint="@color/widget_header_text"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="@dimen/widget_capture_label_gap"
                        android:tintMode="src_in"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/widget_capture_checklist"
                android:background="@drawable/widget_capture_key"
                android:layout_width="@dimen/widget_capture_key_size"
                android:layout_height="@dimen/widget_capture_key_size"
                android:contentDescription="@string/widget_capture_checklist"
                android:layout_marginStart="@dimen/widget_capture_gap">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/widget_capture_checklist_glyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_widget_capture_checklist"
                    android:tint="@color/widget_new_note_ink"
                    android:importantForAccessibility="no"
                    android:tintMode="src_in"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/widget_capture_record"
                android:background="@drawable/widget_capture_key"
                android:layout_width="@dimen/widget_capture_key_size"
                android:layout_height="@dimen/widget_capture_key_size"
                android:contentDescription="@string/widget_capture_record"
                android:layout_marginStart="@dimen/widget_capture_gap">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/widget_capture_record_glyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_widget_capture_record"
                    android:tint="@color/widget_new_note_ink"
                    android:importantForAccessibility="no"
                    android:tintMode="src_in"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/widget_capture_camera"
                android:background="@drawable/widget_capture_key"
                android:layout_width="@dimen/widget_capture_key_size"
                android:layout_height="@dimen/widget_capture_key_size"
                android:contentDescription="@string/widget_capture_camera"
                android:layout_marginStart="@dimen/widget_capture_gap">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/widget_capture_camera_glyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_widget_capture_camera"
                    android:tint="@color/widget_new_note_ink"
                    android:importantForAccessibility="no"
                    android:tintMode="src_in"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/widget_capture_scan"
                android:background="@drawable/widget_capture_key"
                android:layout_width="@dimen/widget_capture_key_size"
                android:layout_height="@dimen/widget_capture_key_size"
                android:contentDescription="@string/widget_capture_scan"
                android:layout_marginStart="@dimen/widget_capture_gap">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/widget_capture_scan_glyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_widget_capture_scan"
                    android:tint="@color/widget_new_note_ink"
                    android:importantForAccessibility="no"
                    android:tintMode="src_in"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_capture_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</FrameLayout>
