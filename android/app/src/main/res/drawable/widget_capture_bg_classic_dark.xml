<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_hairline_dark"/>
            <corners android:radius="@dimen/widget_capture_bar_radius"/>
        </shape>
    </item>
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/widget_paper_dark"
                android:endColor="@color/widget_paper_bottom_dark"
                android:angle="270"/>
            <corners android:radius="@dimen/widget_capture_bar_radius"/>
        </shape>
    </item>
</layer-list>
