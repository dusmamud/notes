<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:startColor="#0fffffff"
                android:endColor="#00ffffff"
                android:angle="270"
                android:type="linear"
                android:centerY="0.22"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_capture_key_radius"/>
        </shape>
    </item>
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:startColor="#0fffffff"
                android:endColor="#00ffffff"
                android:angle="90"
                android:type="linear"
                android:centerY="0.22"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_capture_key_radius"/>
        </shape>
    </item>
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:startColor="#4fffffff"
                android:endColor="#00ffffff"
                android:angle="270"
                android:type="linear"
                android:centerY="0.04"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_capture_key_radius"/>
        </shape>
    </item>
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:startColor="#4affffff"
                android:endColor="#00ffffff"
                android:angle="90"
                android:type="linear"
                android:centerY="0.04"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_capture_key_radius"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="@dimen/widget_capture_key_size"
        android:width="@dimen/widget_capture_key_size">
        <shape
            android:dither="true"
            android:shape="ring"
            android:innerRadiusRatio="2.0633"
            android:thicknessRatio="66.271"
            android:useLevel="false">
            <gradient
                android:startColor="#fe000000"
                android:endColor="#00000000"
                android:angle="0"
                android:type="linear"
                android:centerX="0.44"
                android:centerColor="#00000000"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="@dimen/widget_capture_key_size"
        android:width="@dimen/widget_capture_key_size">
        <shape
            android:dither="true"
            android:shape="ring"
            android:innerRadiusRatio="2.0633"
            android:thicknessRatio="66.271"
            android:useLevel="false">
            <gradient
                android:startColor="#00000000"
                android:endColor="#fe000000"
                android:angle="0"
                android:type="linear"
                android:centerX="0.56"
                android:centerColor="#00000000"/>
        </shape>
    </item>
</layer-list>
