<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_hairline_light"/>
            <corners android:radius="@dimen/widget_corner_radius"/>
        </shape>
    </item>
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/widget_paper_light"
                android:endColor="@color/widget_paper_bottom_light"
                android:angle="270"/>
            <corners android:radius="@dimen/widget_corner_radius"/>
        </shape>
    </item>
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/widget_rim_top_light"
                android:endColor="@color/widget_rim_bottom_light"
                android:angle="270"
                android:type="linear"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_corner_radius"/>
        </shape>
    </item>
    <item
        android:left="0.5dp"
        android:top="1.5dp"
        android:right="0.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/widget_paper_light"
                android:endColor="@color/widget_paper_bottom_light"
                android:angle="270"/>
            <corners android:radius="@dimen/widget_corner_radius"/>
        </shape>
    </item>
    <item
        android:gravity="top|fill_horizontal"
        android:height="4dp"
        android:left="0.5dp"
        android:top="1.5dp"
        android:right="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/widget_glow_top_light"
                android:endColor="#00ffffff"
                android:angle="270"/>
            <corners
                android:topLeftRadius="@dimen/widget_corner_radius"
                android:topRightRadius="@dimen/widget_corner_radius"/>
        </shape>
    </item>
    <item
        android:gravity="bottom|fill_horizontal"
        android:height="3dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/widget_glow_bottom_light"
                android:endColor="#00ffffff"
                android:angle="90"/>
            <corners
                android:bottomLeftRadius="@dimen/widget_corner_radius"
                android:bottomRightRadius="@dimen/widget_corner_radius"/>
        </shape>
    </item>
</layer-list>
