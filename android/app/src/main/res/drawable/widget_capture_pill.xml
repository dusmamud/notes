<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:startColor="#0effffff"
                android:endColor="#00ffffff"
                android:angle="270"
                android:type="linear"
                android:centerY="0.14"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_capture_key_radius"/>
        </shape>
    </item>
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:startColor="#14ffffff"
                android:endColor="#00ffffff"
                android:angle="90"
                android:type="linear"
                android:centerY="0.14"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_capture_key_radius"/>
        </shape>
    </item>
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:startColor="#4affffff"
                android:endColor="#00ffffff"
                android:angle="270"
                android:type="linear"
                android:centerY="0.03"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_capture_key_radius"/>
        </shape>
    </item>
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:startColor="#4affffff"
                android:endColor="#00ffffff"
                android:angle="90"
                android:type="linear"
                android:centerY="0.03"
                android:centerColor="#00ffffff"/>
            <corners android:radius="@dimen/widget_capture_key_radius"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="@dimen/widget_capture_key_size"
        android:width="@dimen/widget_capture_key_size">
        <shape
            android:dither="true"
            android:shape="ring"
            android:innerRadiusRatio="2.0478"
            android:thicknessRatio="210.028"
            android:useLevel="false">
            <gradient
                android:startColor="#33000000"
                android:endColor="#00000000"
                android:angle="0"
                android:type="linear"
                android:centerX="0.18"
                android:centerColor="#00000000"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="@dimen/widget_capture_key_size"
        android:width="@dimen/widget_capture_key_size">
        <shape
            android:dither="true"
            android:shape="ring"
            android:innerRadiusRatio="2.0478"
            android:thicknessRatio="210.028"
            android:useLevel="false">
            <gradient
                android:startColor="#00000000"
                android:endColor="#33000000"
                android:angle="0"
                android:type="linear"
                android:centerX="0.82"
                android:centerColor="#00000000"/>
        </shape>
    </item>
</layer-list>
