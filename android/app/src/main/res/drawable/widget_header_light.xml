<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-1dp"
        android:right="-1dp"
        android:bottom="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/widget_header_line_light"/>
            <corners
                android:topLeftRadius="@dimen/widget_corner_radius"
                android:topRightRadius="@dimen/widget_corner_radius"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#66ffffff"
                android:endColor="#00ffffff"
                android:angle="270"
                android:type="linear"
                android:centerColor="#14ffffff"/>
            <corners
                android:topLeftRadius="@dimen/widget_corner_radius"
                android:topRightRadius="@dimen/widget_corner_radius"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
        </shape>
    </item>
    <item
        android:gravity="top|fill_horizontal"
        android:height="4dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/widget_glow_top_light"
                android:endColor="#00ffffff"
                android:angle="270"/>
            <corners
                android:topLeftRadius="@dimen/widget_corner_radius"
                android:topRightRadius="@dimen/widget_corner_radius"/>
        </shape>
    </item>
    <item android:bottom="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/widget_header_rim_light"/>
            <corners
                android:topLeftRadius="@dimen/widget_corner_radius"
                android:topRightRadius="@dimen/widget_corner_radius"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
        </shape>
    </item>
</layer-list>
