<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="5%">
    <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="#00000000"/>
                <size
                    android:height="44dp"
                    android:width="44dp"/>
            </shape>
        </item>
        <item>
            <shape
                android:dither="true"
                android:shape="rectangle">
                <gradient
                    android:startColor="#0fffffff"
                    android:endColor="#00ffffff"
                    android:angle="270"
                    android:type="linear"
                    android:centerY="0.22"
                    android:centerColor="#00ffffff"/>
                <corners android:radius="@dimen/widget_capture_key_radius"/>
            </shape>
        </item>
        <item>
            <shape
                android:dither="true"
                android:shape="rectangle">
                <gradient
                    android:startColor="#0fffffff"
                    android:endColor="#00ffffff"
                    android:angle="90"
                    android:type="linear"
                    android:centerY="0.22"
                    android:centerColor="#00ffffff"/>
                <corners android:radius="@dimen/widget_capture_key_radius"/>
            </shape>
        </item>
        <item>
            <shape
                android:dither="true"
                android:shape="rectangle">
                <gradient
                    android:startColor="#4fffffff"
                    android:endColor="#00ffffff"
                    android:angle="270"
                    android:type="linear"
                    android:centerY="0.04"
                    android:centerColor="#00ffffff"/>
                <corners android:radius="@dimen/widget_capture_key_radius"/>
            </shape>
        </item>
        <item>
            <shape
                android:dither="true"
                android:shape="rectangle">
                <gradient
                    android:startColor="#4affffff"
                    android:endColor="#00ffffff"
                    android:angle="90"
                    android:type="linear"
                    android:centerY="0.04"
                    android:centerColor="#00ffffff"/>
                <corners android:radius="@dimen/widget_capture_key_radius"/>
            </shape>
        </item>
    </layer-list>
</inset>
